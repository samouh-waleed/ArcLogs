# AWS
AWS_SQS_QUEUE_URL="https://sqs.region.amazonaws.com/account-id/queue-name"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="us-east-2"

# OpenAI (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-proj-..."

# Database
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Optional - for local development
API_BASE_URL="http://localhost:3000"

# Encryption (must match ENCRYPTION_KEY in application/.env)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your-64-char-hex-key-here"

# Sentry (optional — leave empty to disable error monitoring)
# Get DSN from https://sentry.io → Settings → Projects → Client Keys
SENTRY_DSN=""
